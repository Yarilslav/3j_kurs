# Local development defaults. Copy to .env locally, but use AWS Secrets Manager
# or Elastic Beanstalk/ECS environment variables for real deployments.
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Elastic Beanstalk/App Runner may set PORT automatically; set it only when needed.
APP_RELOAD=false

DATABASE_URL=postgresql+psycopg_async://praktychni:change-me@db:5432/praktychni
POSTGRES_DB=praktychni
POSTGRES_USER=praktychni
POSTGRES_PASSWORD=change-me

SECRET_KEY=change-me-to-a-random-32-plus-character-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_NAME=Asahi Admin
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=asahiadm
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PHONE_NUMBER=

FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUN_MIGRATIONS=false
