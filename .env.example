# Local development defaults for docker compose.
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

DATABASE_URL=postgresql+psycopg_async://praktychni:praktychni@db:5432/praktychni
POSTGRES_DB=praktychni
POSTGRES_USER=praktychni
POSTGRES_PASSWORD=praktychni

SECRET_KEY=local-dev-secret-key-change-me-please-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_NAME=Asahi Admin
ADMIN_EMAIL=admin@example.com
ADMIN_LOGIN=asahiadm
ADMIN_PASSWORD=asahi-admin-local-123
ADMIN_PHONE_NUMBER=

FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUN_MIGRATIONS=false
